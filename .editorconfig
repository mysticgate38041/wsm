root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,jsx,ts,tsx,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Historical snapshots retain recorded bytes, including line endings.
[docs/history/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[**/evidence/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[analysis/dump-source-audit/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
